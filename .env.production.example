# Voxium Production Environment
# Copy to .env.production and fill in all values.
# Used by docker-compose.production.yml: the server container reads this file,
# and the compose file takes POSTGRES_PASSWORD and the mediasoup port range
# from it too (--env-file). A commented line is optional: its value is the
# default the server uses when there is one, an example otherwise. The full
# table is in the README ("Configuration Reference").

# ── Set by docker-compose.production.yml (do not set them here) ──────────────
# DATABASE_URL=postgresql://voxium:<POSTGRES_PASSWORD>@postgres:5432/voxium
# REDIS_URL=redis://redis:6379
# NODE_ENV=production

# ── Database (managed by Docker Compose — only set POSTGRES_PASSWORD) ────────
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS
# Token lifetimes: the access token, and the refresh token of a "remember me"
# sign-in (24h otherwise). The defaults are fine; the Cookie Policy states 30
# days for the second.
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# ── TOTP (Two-Factor Authentication) ────────────────────────────────────────
# 32-byte hex key for encrypting TOTP secrets at rest; it also seals the signing
# secret of GitHub-type incoming webhooks (without it, creating or rotating one
# answers 503). Required in production. Generate with: openssl rand -hex 32
# A value that is not 64 hexadecimal characters stops the start.
TOTP_ENCRYPTION_KEY=

# ── S3 / Object Storage ─────────────────────────────────────────────────────
S3_ASSETS_ENDPOINT=https://s3.example.com
S3_ASSETS_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ASSETS_BUCKET=voxium-assets
# Server-side encryption at rest. On startup the server applies BUCKET-DEFAULT
# encryption (PutBucketEncryption) with this algorithm — uploads themselves are
# unchanged, so this is safe with old clients. Requires the S3 key to have
# Get/PutBucketEncryption permission; if the provider doesn't support it the
# server logs an error and continues (enable it in the provider console instead).
S3_SSE=AES256
# Browser uploads go straight to the bucket: it must allow PUT with the
# content-type header from every CORS_ORIGIN origin (GET is optional). On
# startup the server sends the browser's preflight for each origin and logs
# whether the store accepts it (it reads and writes no rule).
# true: after a refusal it also adds the rule, writing back every existing rule
# and changing only the rule named voxium-uploads (needs permission to change
# the bucket's CORS configuration; an edit made to the rules between its read
# and its write is lost).
S3_CORS_APPLY=false

# ── SMTP (required: sign-up codes, e-mail verification, password reset) ─────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Voxium
# Connection security. With neither setting below and NODE_ENV=production
# (the compose file sets it), STARTTLS is REQUIRED: no mail goes to a relay
# that does not complete it. SMTP_SECURE=true for implicit TLS (port 465).
# SMTP_REQUIRE_TLS=false only for a relay on a network you trust: the server
# then sends in plain text when the relay offers no STARTTLS (and says so at
# start).
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# Where the nightly attachment-cleanup report and the hourly sign-up spike
# alert go. Unset: neither is sent.
# CLEANUP_REPORT_EMAIL=admin@example.com

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3001
# Address the compose file publishes the HTTP port on (default: loopback, for
# a proxy on this host). Set it for a proxy elsewhere, and keep the port closed.
# A proxy on this host connects to 127.0.0.1:3001, not localhost:3001 (the name
# also resolves to the IPv6 loopback, where nothing listens). Anything on another
# machine that reads :3001/health directly, an uptime monitor for one, must go
# through the proxy or needs this setting. 0.0.0.0 publishes on every IPv4
# address only (the earlier mapping also published on IPv6); an IPv6 address is
# written in brackets, for example [::1].
# VOXIUM_HTTP_BIND=127.0.0.1
## Web origin + Tauri desktop origins (one per platform):
## Windows: https://tauri.localhost | macOS: tauri://localhost | Linux: http://tauri.localhost
CORS_ORIGIN=https://chat.example.com,https://tauri.localhost,tauri://localhost,http://tauri.localhost
# The web client's address, used for the links in e-mails.
CLIENT_URL=https://chat.example.com
# This server process's name in a cluster: one stable value per node (server-1,
# server-2...), never the same for two processes running at once. Unset, each
# start picks a random one; a process killed without a clean stop then looks
# like a live peer to its own replacement for up to 30 s. Leave it unset if
# several containers share this file.
# NODE_ID=server-1

# ── Reverse Proxy ────────────────────────────────────────────────────────────
# Behind a reverse proxy the server must trust X-Forwarded-For. NODE_ENV=production
# (set by the compose file) already turns it on; this says so explicitly.
TRUST_PROXY=true
# Reverse-proxy hops in front of this container (1 = nginx alone; 2 = a load
# balancer in front of nginx). Must match the topology exactly.
# TRUST_PROXY_HOPS=1

# ── mediasoup (Voice) ─────────────────────────────────────────────────────────
# MEDIASOUP_LISTEN_IP: IP the workers bind to (0.0.0.0 inside Docker)
# MEDIASOUP_ANNOUNCED_IP: the public address clients send voice media to
# (REQUIRED for voice)
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=YOUR_PUBLIC_OR_LAN_IP
# One WebRtcServer per worker on MIN_PORT + slot (udp+tcp), one worker per CPU
# core (max 8): MIN..MIN+7 is enough, and docker-compose publishes exactly this
# range. Only MEDIASOUP_WEBRTC_SERVER=false (legacy per-transport ports: each
# transport binds its own port, two per user) needs a wide range — and then
# the compose port mapping must widen with it.
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10007
# Fewer workers than CPU cores (at most 8 either way).
# MEDIASOUP_NUM_WORKERS=
# MEDIASOUP_WEBRTC_SERVER=true

# ── Logging (optional) ──────────────────────────────────────────────────────
# Access log format: `json` (one JSON line per request) or `dev`.
# LOG_FORMAT=json

# ── One-off switches (set for one start or one command, then remove) ─────────
# VOXIUM_ALLOW_CUTOVER=1  lets the container apply the always-on E2E cutover
# migration, which deletes all DM history and every E2E key: read the README
# ("Docker Deployment") and docs/e2e-always-on-plan.md first. The demo seed's
# VOXIUM_ALLOW_DEMO_SEED never belongs in this file.
