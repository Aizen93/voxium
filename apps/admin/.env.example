# Admin dashboard build settings. Copy to apps/admin/.env (or .env.local /
# .env.production): Vite compiles these values into the bundle, so a change
# means a new build. The values below are the defaults the code uses when a
# line is left out.

# The API the dashboard talks to, and the Socket.IO server (live metrics).
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001

# Not read from this file, only from the environment of the command:
#   VOXIUM_DEV_LAN=1   the Vite dev server listens on every interface instead
#                      of 127.0.0.1 (testing from another machine)
