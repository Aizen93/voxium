# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/voxium?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── TOTP (Two-Factor Authentication) ──────────────────────────────────────
# 32-byte hex key for encrypting TOTP secrets at rest. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8080"

# ─── SMTP (Email) ────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@voxium.app
CLIENT_URL=http://localhost:8080

# ─── mediasoup (WebRTC) ──────────────────────────────────────────────────────
MEDIASOUP_LISTEN_IP="0.0.0.0"
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100
# One WebRtcServer per worker on MIN_PORT + slot (udp+tcp); `false` = legacy per-transport ports
# MEDIASOUP_WEBRTC_SERVER=true

# ─── Reverse proxy ───────────────────────────────────────────────────────────
# Trusted only when NODE_ENV=production or TRUST_PROXY=true. HOPS = how many
# proxies sit in front of this process (1 = nginx alone; 2 = a load balancer
# in front of nginx). Must match the topology exactly — see DEPLOYMENT.md §7.
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# ─── Object storage (avatars, icons, attachments) ────────────────────────────
# USE A DEV BUCKET. Uploads go straight from the browser to a presigned URL, so
# whatever bucket is named here is written to for real — pointing this at the
# production bucket means every test run litters it with real objects.
S3_ASSETS_ENDPOINT="https://s3.example-region.your-provider.example"
S3_ASSETS_REGION="eu-west-1"
S3_ASSETS_BUCKET="dev-voxium-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Optional bucket-default encryption: AES256 | aws:kms (never set on presigned PUTs)
S3_SSE=""
#
# A new bucket needs a CORS policy before browser uploads work, or they fail as
# an opaque "TypeError: Failed to fetch" with nothing in the server log:
#   npx tsx scripts/setup-dev-bucket.ts
