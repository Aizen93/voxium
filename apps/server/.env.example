# Every setting the server reads. A commented line is optional: its value is
# the default the code uses when there is one (empty when there is none).
# The full table is in the README ("Configuration Reference").

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/voxium?schema=public"
# The most connections this process's database pool opens at once: a whole
# number from 1 to 1000. Any other value reads 10, with a warning.
# DATABASE_POOL_MAX=10
# How long an idle connection stays open, in milliseconds: a whole number from
# 0 (never closed) to 3600000. Unset reads 10000; any other value reads 10000
# too, with a warning.
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# How long a request waits for a connection, in milliseconds: a whole number
# from 0 (no limit) to 600000. Unset reads 0; any other value reads 0 too,
# with a warning.
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=0

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"
# Access token lifetime, and the refresh token's for a "remember me" sign-in
# (24h otherwise). Any value jsonwebtoken reads: 15m, 12h, 30d.
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── TOTP (Two-Factor Authentication) ──────────────────────────────────────
# 32-byte hex key for encrypting TOTP secrets at rest; it also seals the signing
# secret of GitHub-type incoming webhooks (without it, creating or rotating one
# answers 503). Generate with: openssl rand -hex 32
# A value that is not 64 hexadecimal characters stops the start.
TOTP_ENCRYPTION_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# `production` makes TOTP_ENCRYPTION_KEY mandatory, turns on HSTS, the trusted
# proxy, JSON access logs and the STARTTLS requirement for mail.
NODE_ENV="development"
# Allowed browser origins, comma-separated (web client, admin dashboard, the
# desktop app's origins in production).
CORS_ORIGIN="http://localhost:8080"
# The web client's address, used for the links in e-mails.
CLIENT_URL=http://localhost:8080
# This process's name in a cluster: one stable value per node, never shared by
# two processes running at once. Unset, each start picks a random one, and a
# process killed without a clean stop then looks like a live peer to its own
# replacement for up to 30 s (its heartbeat), which delays the stale-presence
# cleanup at start.
# NODE_ID=
# Access log format: `json` (one JSON line per request) or `dev`. Default:
# json when NODE_ENV=production, dev otherwise.
# LOG_FORMAT=dev

# ─── SMTP (Email) ────────────────────────────────────────────────────────────
# Sign-up codes, verification and password-reset links. In development a
# local catcher on 1025 (e.g. Mailpit) is enough.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@voxium.app
# SMTP_FROM_NAME=Voxium
# Connection security. SMTP_SECURE=true: implicit TLS (usually port 465).
# SMTP_REQUIRE_TLS=true: STARTTLS, or no mail at all; false: STARTTLS when the
# relay offers it, plain text otherwise. Neither set: required when
# NODE_ENV=production, opportunistic otherwise (a plain local catcher works).
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=
# Where the nightly attachment-cleanup report and the hourly sign-up spike
# alert go. Unset: neither is sent.
# CLEANUP_REPORT_EMAIL=

# ─── mediasoup (WebRTC) ──────────────────────────────────────────────────────
MEDIASOUP_LISTEN_IP="0.0.0.0"
# The address clients send voice media to. Use this machine's LAN address,
# even for a test on this machine alone: Firefox does not complete ICE/DTLS
# against a loopback address (127.0.0.1), so its voice fails there. In
# production, the public address.
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100
# Workers: one per CPU core, at most 8; this lowers the count.
# MEDIASOUP_NUM_WORKERS=
# One WebRtcServer per worker on MIN_PORT + slot (udp+tcp); `false` = legacy per-transport ports
# MEDIASOUP_WEBRTC_SERVER=true

# ─── Reverse proxy ───────────────────────────────────────────────────────────
# Trusted only when NODE_ENV=production or TRUST_PROXY=true. HOPS = how many
# proxies sit in front of this process (1 = nginx alone; 2 = a load balancer
# in front of nginx). Must match the topology exactly.
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# ─── Object storage (avatars, icons, attachments) ────────────────────────────
# USE A DEV BUCKET. Uploads go straight from the browser to a presigned URL, so
# whatever bucket is named here is written to for real — pointing this at the
# production bucket means every test run litters it with real objects.
S3_ASSETS_ENDPOINT="https://s3.example-region.your-provider.example"
S3_ASSETS_REGION="eu-west-1"
S3_ASSETS_BUCKET="dev-voxium-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Optional bucket-default encryption: AES256 | aws:kms (never set on presigned PUTs)
S3_SSE=""
#
# The bucket must allow PUT with the content-type header from every CORS_ORIGIN
# origin (GET is optional), or browser uploads fail as an opaque "TypeError:
# Failed to fetch". At every start the server sends the browser's preflight for
# each origin and logs one line saying whether the store accepts it (it reads
# and writes no rule). For a dev bucket, the script writes the rule:
#   npx tsx scripts/setup-dev-bucket.ts
# With S3_CORS_APPLY=true the server adds the rule itself after a refusal: it
# writes back every existing rule and changes only the rule named
# voxium-uploads (the key needs permission to change the bucket's CORS
# configuration; an edit made to the rules between its read and its write is
# lost). Default: false, check only.
S3_CORS_APPLY=""
