# Web client and desktop app build settings. Copy to apps/desktop/.env (or
# .env.local / .env.production): Vite compiles these values into the bundle,
# so a change means a new build (and new desktop installers). The values
# below are the defaults the code uses when a line is left out.

# The API the client talks to, and the Socket.IO server.
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001

# The public web client's origin, for the invite links the DESKTOP app hands
# out (https://host[:port], no path). A browser always uses the page's own
# origin and ignores it. A desktop build without it starts its links with
# VITE_WS_URL, which opens the invite page only if the web client is served
# on that origin too.
# VITE_CLIENT_URL=https://chat.example.com

# STUN server for direct (DM) calls: stun:host[:port] or stuns:host[:port]
# only. Default: stun:<host of VITE_WS_URL>:3478. Set it when that host does
# not reach the machine coturn runs on.
# VITE_STUN_URL=stun:stun.example.com:3478

# Not read from this file, only from the environment of the command:
#   VOXIUM_DEV_LAN=1          the Vite dev server listens on every interface
#                             instead of 127.0.0.1 (testing from another machine)
#   TAURI_ASSET_ORIGIN, TAURI_UPDATER_ENDPOINTS, TAURI_UPDATER_PUBKEY,
#   TAURI_SIGNING_PRIVATE_KEY(_PASSWORD)
#                             `pnpm tauri:build` (see the README, "Build the
#                             Desktop App")
