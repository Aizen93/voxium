{
  "name": "voxium",
  "version": "2.0.0",
  "private": true,
  "description": "Voxium - Modern voice & text communication platform",
  "scripts": {
    "dev:server": "pnpm --filter @voxium/server dev",
    "dev:desktop": "pnpm --filter @voxium/desktop dev",
    "dev:admin": "pnpm --filter @voxium/admin dev",
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "pnpm --parallel --filter @voxium/server --filter @voxium/desktop run dev",
    "build:shared": "pnpm --filter @voxium/shared build",
    "build:server": "pnpm --filter @voxium/server build",
    "build:desktop": "pnpm --filter @voxium/desktop build",
    "build:admin": "pnpm --filter @voxium/admin build",
    "build": "pnpm run build:shared && pnpm --parallel --filter @voxium/server --filter @voxium/desktop run build",
    "typecheck": "pnpm run build:shared && pnpm --filter @voxium/server exec tsc --noEmit && pnpm --filter @voxium/desktop exec tsc --noEmit && pnpm --filter @voxium/admin exec tsc --noEmit",
    "lint": "pnpm run --parallel -r lint",
    "db:migrate": "pnpm --filter @voxium/server db:migrate",
    "db:seed": "pnpm --filter @voxium/server db:seed",
    "db:studio": "pnpm --filter @voxium/server db:studio",
    "test": "pnpm --filter @voxium/server test && pnpm --filter @voxium/desktop test && pnpm --filter @voxium/admin test",
    "test:watch": "pnpm --filter @voxium/server test:watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "mediasoup",
      "prisma"
    ],
    "overrides": {
      "rollup": ">=4.59.0",
      "esbuild": ">=0.28.1",
      "fast-xml-parser": ">=5.10.1",
      "fast-xml-builder": ">=1.1.7",
      "tar": ">=7.5.21",
      "flatted": ">=3.4.2",
      "socket.io-parser": ">=4.2.7",
      "ws": ">=8.21.0",
      "path-to-regexp": ">=8.4.0",
      "undici": ">=7.29.1 <8",
      "form-data": ">=4.0.6",
      "qs": ">=6.16.0",
      "postcss": ">=8.5.23",
      "brace-expansion": ">=5.0.12",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "hono": ">=4.13.11",
      "@hono/node-server": ">=2.0.10",
      "lodash": ">=4.18.0"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@roamhq/wrtc": "^0.10.0",
    "eslint": "^10.0.3",
    "mediasoup-client": "^3.18.7",
    "otpauth": "^9.5.0",
    "redis": "^5.11.0",
    "typescript-eslint": "^8.57.1"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
