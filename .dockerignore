# Patterns match from the context root: nested copies need **/ (a local checkout
# has apps/*/node_modules, and copying them breaks the image build).
node_modules
**/node_modules
dist
**/dist
build
target
.git
.github
# Exclude .env files in ALL directories (not just root)
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
*.log
.DS_Store
Thumbs.db
.turbo
coverage
.nyc_output
test-results
playwright-report
blob-report
tests
**/__tests__
**/*.test.ts
**/*.spec.ts
scripts
*.md
.claude
apps/desktop
apps/admin
